{
  "name": "@statekeep/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for StateKeep — statechart hosting with path-based actor migration",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --declaration --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/client.test.js"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "engines": { "node": ">=18.0.0" },
  "license": "UNLICENSED",
  "keywords": ["xstate", "statechart", "workflow", "state-machine", "migration"]
}
