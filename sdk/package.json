{
  "name": "@statekeep/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the StateKeep Actor Lifecycle API",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
