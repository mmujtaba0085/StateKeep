# ──────────────────────────────────────────────────────────────────────────────
# StateKeep — Environment Configuration
# Copy this file to .env and fill in the required secrets. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required secrets ──────────────────────────────────────────────────────────

# AES-256-GCM key for actor context encryption (64 hex characters = 32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATEKEEP_ENCRYPTION_KEY=

# Secret for /v1/admin/* routes (restart workers, force migrations, etc.).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATEKEEP_ADMIN_KEY=

# Default org API key seeded into the DB on first start.
# Use this key in the x-api-key header for all API calls.
# Format: any string you choose, e.g. sk_live_<random>
STATEKEEP_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────

# SQLite database path (default, zero-config).
STATEKEEP_DB_PATH=/opt/statekeep/data/statekeep.db

# Postgres connection URL. When set, the server uses Postgres instead of SQLite.
# Leave unset to use SQLite.
# STATEKEEP_DB_URL=postgresql://statekeep:password@localhost:5432/statekeep

# ── Server ────────────────────────────────────────────────────────────────────

# Interface to listen on. Defaults to 0.0.0.0 when STATEKEEP_API_KEY is set,
# otherwise 127.0.0.1 (an unauthenticated API is never exposed by accident).
# HOST=0.0.0.0

# Reverse proxies whose X-Forwarded-For header is trusted (client IP for rate limiting).
# Unset = trust none. Examples: loopback | 10.0.0.0/8,127.0.0.1
# STATEKEEP_TRUST_PROXY=loopback

# Allow an unauthenticated API on a non-loopback HOST (e.g. behind an auth proxy).
# STATEKEEP_ALLOW_UNAUTHENTICATED=false

# Event durability: group (default, ack only after commit) | buffered (faster, may
# lose up to STATEKEEP_WRITE_BUFFER_MS of acknowledged events on a crash) | sync
# STATEKEEP_DURABILITY=group

# HTTP port for the Fastify API.
PORT=3001

# Node environment (production | development).
NODE_ENV=production

# Log directory (must be writable).
LOG_DIR=/var/log/statekeep

# ── Performance tuning ────────────────────────────────────────────────────────

# Maximum actors in the hot LRU registry (in-memory cache).
HOT_REGISTRY_SIZE=10000

# Maximum actors per worker thread (used to auto-size the worker pool).
ACTORS_PER_WORKER=500

# Explicit worker thread count (overrides CPU-based auto-detection).
# Default: max(4, min(32, cpu_cores)).
# STATEKEEP_WORKER_COUNT=8

# Seconds before an idle actor is evicted from the hot registry to SQLite.
IDLE_TIMEOUT_SECONDS=300

# Write buffer flush interval in milliseconds (default: 50).
# Increase for higher write throughput at the cost of a larger crash window.
# STATEKEEP_WRITE_BUFFER_MS=50

# ── Optional features ─────────────────────────────────────────────────────────

# Guards/actions implemented by your own HTTP service (any language) — see
# docs/remote-implementations.md
# STATEKEEP_REMOTE_URL=http://credit-service.internal:8080/statekeep
# STATEKEEP_REMOTE_SECRET=

# Path to your implementation registry module (guards, actions, invoke services).
# If unset, guards resolve false and actions are no-ops.
# STATEKEEP_REGISTRY_PATH=/opt/statekeep/registry.js

# Disable the HTTP rate limiter (safe behind a trusted reverse proxy).
# STATEKEEP_RATE_LIMIT=false

# Confirm-token TTL in milliseconds (default: 300000 = 5 minutes).
# CONFIRM_TOKEN_TTL_MS=30000

# Maximum event history to retain per actor in days (0 = retain forever).
# Events older than this are pruned by gc-worker. WARNING: once enabled, the event
# history is no longer a complete audit log and cannot be replayed to the current state
# (routing is unaffected: it uses stored fingerprints).
# STATEKEEP_MAX_EVENT_HISTORY_DAYS=90

# ── Cluster mode: several API servers, one Postgres (docs/multi-server.md) ──
# STATEKEEP_CLUSTER=true
# STATEKEEP_NODE_URL=http://10.0.0.11:3001   # how the other servers reach this one
# STATEKEEP_NODE_ID=api-1                    # optional
# STATEKEEP_NODE_TTL_MS=5000                 # owner considered dead after this long

# How long a claimed action job is reserved (renewed while it runs). docs/side-effects.md
# STATEKEEP_ACTION_LEASE_MS=120000
# Longest wait between two retries of an action (exponential backoff cap)
# STATEKEEP_ACTION_BACKOFF_MAX_MS=300000
