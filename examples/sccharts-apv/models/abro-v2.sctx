// ABRO v2: field fix. A backup sensor T may stand in for A.
// Deployed only to instances whose whole history is exactly [WaitB->DoneB].
scchart ABRO {
  input bool A, B, R, T
  output bool O = false

  initial state ABthenO {
    entry do O = false
    initial state WaitAB {
      region HandleA {
        initial state WaitA
          if A || T go to DoneA
        final state DoneA
      }
      region HandleB {
        initial state WaitB
          if B go to DoneB
        final state DoneB
      }
    }
    do O = true join to Done
    final state Done
  }
  if R abort to ABthenO
}
