{
  "definitionId": "order-v1",
  "definition": {
    "id": "order",
    "initial": "pending",
    "states": {
      "pending":   { "on": { "PAY": "paid", "CANCEL": "cancelled" } },
      "paid":      { "on": { "SHIP": "shipped", "REFUND": "refunded" } },
      "shipped":   { "on": { "DELIVER": "delivered", "RETURN": "returning" } },
      "returning": { "on": { "RECEIVED": "refunded" } },
      "delivered": { "type": "final" },
      "refunded":  { "type": "final" },
      "cancelled": { "type": "final" }
    }
  },
  "scenarios": [
    {
      "name": "happy path — pay, ship, deliver",
      "events": ["PAY", "SHIP", "DELIVER"],
      "expectedStates": ["paid", "shipped", "delivered"],
      "expectDone": true
    },
    {
      "name": "cancel before payment",
      "events": ["CANCEL"],
      "expectedStates": ["cancelled"],
      "expectDone": true
    },
    {
      "name": "return and refund",
      "events": ["PAY", "SHIP", "RETURN", "RECEIVED"],
      "expectedStates": ["paid", "shipped", "returning", "refunded"],
      "expectDone": true
    },
    {
      "name": "invalid transition — ship without paying (should stay pending)",
      "events": ["SHIP"],
      "expectedStates": ["pending"],
      "expectDone": false
    }
  ]
}
